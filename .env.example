# ═══ מסד נתונים ═══
# Neon / Railway / Postgres: הדביקו מהדשבורד (/sslmode=require)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"
# מקומית עם Docker: docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lebronator"

# ═══ חילוץ ציונים (OCR) ═══
# openai = תמונה ל-GPT  |  mock = דמו בלי AI
OCR_PROVIDER="openai"

# מ־https://platform.openai.com/api-keys — רק בקובץ זה, לא ב-Git
OPENAI_API_KEY=""

# gpt-4o = הכי מדויק לעברית (יקר)  |  gpt-4o-mini = חסכוני
OPENAI_OCR_MODEL="gpt-4o"

# ═══ Multi-branch defaults (pilot) ═══
# Used to create/attach the seeded admin user branch.
DEFAULT_BRANCH_CODE="main"
DEFAULT_BRANCH_NAME="Main Branch"

# ═══ Authentication (NextAuth) ═══
# Generate once: `openssl rand -base64 32` or any secure secret generator
NEXTAUTH_SECRET=""
# Public app URL in production
NEXTAUTH_URL="http://localhost:3000"

# Default seeded admin credentials (change immediately in real deployments)
DEFAULT_ADMIN_EMAIL="admin@district.local"
DEFAULT_ADMIN_NAME="District Admin"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
