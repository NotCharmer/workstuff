# ═══ Database ═══
# Neon / Railway / Postgres: paste from provider dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# If `P1001 Can't reach database server` persists on Windows (even on different Wi‑Fi),
# your PC may be blocking outbound TCP 5432, or Neon compute is suspended. Options:
# - Wake DB from Neon Console (SQL Editor / Connect), wait ~30s, retry.
# - Install Docker Desktop, run `docker compose up -d`, then use:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lebronator"
#   and run `npx prisma db push` + `npm run db:seed`.

# ═══ העלאת ציונים ═══
# Default: import only students who have at least one grade in python / electronics / branding / final project;
# all subjects for those students are saved. Set "false" to import every student in the file.
# UPLOAD_TARGET_SUBJECTS_ONLY="false"

# ═══ חילוץ ציונים (OCR) ═══
# openai = תמונה ל-GPT  |  mock = דמו בלי AI
OCR_PROVIDER="openai"

# מ־https://platform.openai.com/api-keys — רק בקובץ זה, לא ב-Git
OPENAI_API_KEY=""

# gpt-4o = הכי מדויק לעברית (יקר)  |  gpt-4o-mini = חסכוני
OPENAI_OCR_MODEL="gpt-4o"

# ═══ Multi-branch defaults (pilot) ═══
# Used to create/attach the seeded admin user branch.
DEFAULT_BRANCH_CODE="rehovot"
DEFAULT_BRANCH_NAME="רחובות"

# ═══ Authentication (NextAuth) ═══
# Generate once: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
# Local dev: must be http://localhost:3000 (use .env.local so production URL in .env does not break local login)
NEXTAUTH_URL="http://localhost:3000"
# Production (Vercel only): https://workstuff-omega.vercel.app
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISTRICT_GOOGLE_DOMAIN="district.local"
# Optional: exact allowlist. If set, this overrides DISTRICT_GOOGLE_DOMAIN checks.
ALLOWED_GOOGLE_EMAILS="principal@example.com,manager@example.com"

# Default seeded admin credentials (change immediately in real deployments)
DEFAULT_ADMIN_EMAIL="mercazhadash@gmail.com"
DEFAULT_ADMIN_NAME="מנהל מערכת"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"

# First-login password for STAFF users created by admin in team panel (optional custom password).
DEFAULT_STAFF_PASSWORD="Staff123!"

# Staff entry gate — NOT a real user. Opens self-registration after login with these credentials.
STAFF_GATE_EMAIL="staff@mercaz.local"
# STAFF_GATE_PASSWORD defaults to DEFAULT_STAFF_PASSWORD if unset
