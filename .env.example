# ═══ מסד נתונים ═══
DATABASE_URL="file:./dev.db"
# (אופציונלי) Postgres: עדכנו ב-prisma/schema.prisma והחליפו URL

# ═══ חילוץ ציונים (OCR) ═══
# openai = תמונה ל-GPT  |  mock = דמו בלי AI
OCR_PROVIDER="openai"

# מ־https://platform.openai.com/api-keys — רק בקובץ זה, לא ב-Git
OPENAI_API_KEY=""

# gpt-4o = הכי מדויק לעברית (יקר)  |  gpt-4o-mini = חסכוני
OPENAI_OCR_MODEL="gpt-4o"
