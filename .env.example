# ═══ Database ═══
# Neon / Railway / Postgres: paste from provider dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ═══ חילוץ ציונים (OCR) ═══
# openai = תמונה ל-GPT  |  mock = דמו בלי AI
OCR_PROVIDER="openai"

# מ־https://platform.o# Google SSO (district-only gate)penai.com/api-keys — רק בקובץ זה, לא ב-Git
OPENAI_API_KEY=""

# gpt-4o = הכי מדויק לעברית (יקר)  |  gpt-4o-mini = חסכוני
OPENAI_OCR_MODEL="gpt-4o"

# ═══ Multi-branch defaults (pilot) ═══
# Used to create/attach the seeded admin user branch.
DEFAULT_BRANCH_CODE="main"
DEFAULT_BRANCH_NAME="Main Branch"

# ═══ Authentication (NextAuth) ═══
# Generate once: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
# Public app URL in production (no path)
NEXTAUTH_URL="http://localhost:3000"


GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISTRICT_GOOGLE_DOMAIN="district.local"

# Default seeded admin credentials (change immediately in real deployments)
DEFAULT_ADMIN_EMAIL="admin@district.local"
DEFAULT_ADMIN_NAME="District Admin"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
