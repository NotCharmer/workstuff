// Lebronator schema
// --------------------------------------------------------------
// PostgreSQL for production/hosting (Neon, Railway, etc.). Enum-like fields
// are plain strings enforced in application code (see src/lib/enums.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  passwordHash String?
  branchId  String?
  // UserRole: "STAFF" | "BRANCH_MANAGER" | "ADMIN"
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  notes      Note[]
  uploads    UploadSession[]
  dailyTasks DailyTask[]

  @@index([branchId])
}

model Student {
  id         String   @id @default(cuid())
  branchId   String?
  externalId String?  // the school's student ID as printed on rosters
  firstName  String
  lastName   String
  className  String?  // e.g. "10-B"
  // StudentGender: "MALE" | "FEMALE"
  gender     String?
  avatarHue  Int      @default(210) // used to color initials avatar
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  grades         Grade[]
  notes          Note[]
  privateLessons PrivateLesson[]

  @@unique([branchId, externalId])
  @@index([branchId])
  @@index([lastName, firstName])
  @@index([className])
}

model PrivateLesson {
  id              String   @id @default(cuid())
  studentId       String
  date            String   // ISO date: "YYYY-MM-DD"
  durationMinutes Int      @default(60)
  subject         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
}

model Subject {
  id          String  @id @default(cuid())
  branchId    String?
  name        String
  code        String?
  color       String  @default("#6366f1")
  isImportant Boolean @default(false)
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  grades      Grade[]

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@index([branchId])
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  value     Float
  term      String?  // "Fall 2024", "Q1", etc.
  gradedAt  DateTime @default(now())
  // GradeSource: "MANUAL" | "OCR" | "IMPORT"
  source    String   @default("MANUAL")
  uploadId  String?

  student  Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  upload   UploadSession? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([subjectId])
  @@index([gradedAt])
}

model Note {
  id        String   @id @default(cuid())
  studentId String
  authorId  String?
  // NoteCategory: "GENERAL" | "BEHAVIOR" | "PROGRESS" | "CONCERN" | "STRENGTH"
  category  String   @default("GENERAL")
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([studentId])
}

model UploadSession {
  id            String   @id @default(cuid())
  branchId      String?
  uploaderId    String?
  fileName      String
  imagePath     String?
  // UploadStatus: "PARSED" | "REVIEWED" | "SAVED" | "DISCARDED"
  status        String   @default("PARSED")
  rowCount      Int      @default(0)
  avgConfidence Float?
  createdAt     DateTime @default(now())

  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  uploader User?   @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  grades   Grade[]

  @@index([branchId])
}

model DailyTask {
  id        String   @id @default(cuid())
  branchId  String?
  authorId  String?
  title     String
  done      Boolean  @default(false)
  date      String   // ISO date: "YYYY-MM-DD"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([date])
}

model ClassVisit {
  id              String   @id @default(cuid())
  branchId        String?
  date            String   // ISO date: "YYYY-MM-DD"
  className       String
  subject         String
  durationMinutes Int      @default(60)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([date])
  @@index([className])
}

model TimetableEntry {
  id        String   @id @default(cuid())
  branchId  String?
  className String
  dayOfWeek String
  startTime String
  endTime   String
  subject   String
  teacher   String?
  room      String?
  source    String   @default("IMPORT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([className, dayOfWeek, startTime])
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  students   Student[]
  subjects   Subject[]
  uploads    UploadSession[]
  dailyTasks DailyTask[]
  classVisits ClassVisit[]
  timetableEntries TimetableEntry[]
}
